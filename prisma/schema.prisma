generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id            String    @id
  firstName     String?
  lastName      String?
  gender        String?
  birthDate     DateTime? @db.Date
  deathDate     DateTime? // null = alive (823/1280 Coherent patients have a death date)
  phone         String?
  maritalStatus String?
  race          String?
  ethnicity     String?
  city          String?
  state         String?

  // --- Week 4: what an agent is allowed to change ---
  // Soft delete. Nothing in this course ever issues a DELETE against a patient
  // or a note; "removing" a record means stamping deletedAt and filtering it
  // out on read. A soft delete you forget to filter on is just a lie, so every
  // read path (SQL agent, vectorize, patient lookup) must exclude these.
  deletedAt DateTime?

  // A reversible, low-stakes write — the first action we let a tool perform,
  // and only after a human confirms it.
  followUpFlag   Boolean @default(false)
  followUpReason String?

  conditions   Condition[]
  observations Observation[]
  medications  Medication[]
  encounters   Encounter[]
  notes        Note[]

  @@index([lastName, firstName])
  @@index([deletedAt])
  @@map("patients")
}

model Condition {
  id             String    @id
  patientId      String
  code           String? // SNOMED code
  display        String // e.g. "Type 2 Diabetes Mellitus"
  clinicalStatus String? // active | resolved | inactive
  onsetDate      DateTime?
  abatementDate  DateTime?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([display])
  @@map("conditions")
}

model Observation {
  id            String    @id
  patientId     String
  code          String? // LOINC code
  display       String // e.g. "Hemoglobin A1c"
  category      String? // laboratory | vital-signs | survey | ...
  valueNumber   Float?
  valueString   String?
  unit          String?
  effectiveDate DateTime?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([code])
  @@index([display])
  @@map("observations")
}

model Medication {
  id         String    @id
  patientId  String
  code       String? // RxNorm code
  display    String // e.g. "Simvastatin 10 MG Oral Tablet"
  status     String? // active | stopped | completed
  authoredOn DateTime?
  dosage     String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([display])
  @@map("medications")
}

// Clinical notes live here too: Postgres is the system of record for ALL data.
// Pinecone is a DERIVED index (note text + metadata) kept in sync from this table.
model Note {
  id        String    @id // DocumentReference id — also the vector id in Pinecone
  patientId String
  type      String? // e.g. "History and physical note"
  date      DateTime?
  content   String // the full note text (~450 chars avg); the source of truth

  // Soft delete. Retracting a note is a two-step write: stamp deletedAt in
  // Postgres AND delete the vector from Pinecone. Do only the first and the
  // note stays searchable — a derived index that outlives its source is the
  // bug this teaches.
  deletedAt DateTime?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([deletedAt])
  @@map("notes")
}

model Encounter {
  id              String    @id
  patientId       String
  classCode       String? // HL7 v3 ActCode: AMB (ambulatory) | EMER (emergency) | IMP (inpatient)
  type            String? // e.g. "Encounter for problem", "General examination of patient"
  status          String? // finished | in-progress | planned | cancelled
  startDate       DateTime?
  endDate         DateTime?
  serviceProvider String? // organization display, if present

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([classCode])
  @@map("encounters")
}

// Every write an agent makes, recorded before it happens.
//
// This is what makes an agent write action defensible: not that the model is
// trustworthy, but that the change is attributable, reviewable and reversible.
// `before` holds the prior value, so any single action can be undone by hand.
model AuditLog {
  id             String   @id @default(uuid())
  at             DateTime @default(now())
  // Who asked. No login in this course, so it's the channel name
  // ("chat", "eval", "script") — swap for a user id when you add auth.
  actor          String
  // The tool that ran, e.g. "soft_delete_note", "flag_patient_for_follow_up".
  action         String
  entity         String // "patient" | "note"
  entityId       String
  before         Json? // prior value — the undo button
  after          Json? // what it became
  reason         String? // why the model said it was doing this
  // False means the write happened without a human clicking confirm. In this
  // codebase that should never be true for a destructive-ish action; assert on
  // it in your evals.
  humanConfirmed Boolean  @default(false)

  @@index([entity, entityId])
  @@index([at])
  @@map("audit_log")
}
