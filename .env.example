# ===========================================
# Your database — we provide it
# ===========================================
# You do NOT create a database or sign up for Neon. Your instructor posts a
# connection string in Slack: it points at your own private Neon branch of the
# course database, already carrying the schema and all ~21k clinical notes.
#
# Paste the whole string, including the ?sslmode=require on the end.
#
# It's yours and it's writable, so you can break it. `npm run db:reset` undoes
# every write the agent made; if you ever want a genuinely pristine copy, ask in
# Slack for a fresh branch — it's one click on our side.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/medical?sslmode=require"

# ===========================================
# Pinecone — vector search over the clinical notes
# ===========================================
# Sign up at https://pinecone.io. This one IS yours to create — you build the
# index in week 1 and it's the thing you'll be tuning all course.
#
# `npm run vectorize` creates it for you (1536 dimensions, cosine), or make it by
# hand in the console — but the name here MUST match the one there. A mismatch is
# a 404 that looks like a bad key; `npm run doctor` catches it.
#
# Reranking uses this same key — Pinecone hosts bge-reranker-v2-m3, no separate
# provider needed.
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=medical-notes

# ===========================================
# OpenAI — embeddings + chat
# ===========================================
OPENAI_API_KEY=sk-...
# If your cohort uses the class proxy (budgeted keys), set the base URL to the
# proxy and leave it set. Forgetting this is the #1 cause of "invalid API key".
# Leave it commented out to hit api.openai.com directly with your own key.
# OPENAI_BASE_URL=https://parsity-litellm.fly.dev

# ===========================================
# LangSmith — observability (needed from week 2)
# ===========================================
# https://smith.langchain.com → Settings → API Keys.
# Tracing is on as soon as these are set: lib/openai.ts wraps the client once
# and every agent inherits it.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=medical-rag

# ===========================================
# Cal.com — appointment scheduling (needed from week 4)
# ===========================================
# https://cal.com (free). Create an event type; its ID is in the URL when you
# edit it (/event-types/[ID]). API key: Settings → Developer → API Keys.
CAL_API_KEY=cal_live_...
CAL_EVENT_TYPE_ID=123456

# ===========================================
# Privacy — PII obscuring (week 5)
# ===========================================
# The default for the de-identification pass. The front-office channel always
# obscures; the clinician chat returns full data. This only decides behaviour
# when no explicit flag is passed. 'true' → names become pseudonyms
# (Patient-A7B3), dates show the year only (1985-XX-XX), locations redacted.
OBSCURE_PII=false

# ===========================================
# Instructor / capstone only — ignore these
# ===========================================
# Used by `npm run db:seed` and `npm run db:export-seed`, which build the course
# branch in the first place. Students never need either. See docs/INSTRUCTOR-DB.md.
# SEED_DATA_URL=
#
# Bulk loads are more reliable on Neon's DIRECT (non-pooled) connection. The
# scripts derive it by dropping "-pooler" from DATABASE_URL; set this only if
# your host doesn't follow that convention.
# DIRECT_URL=
